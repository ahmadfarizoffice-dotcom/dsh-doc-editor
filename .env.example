# DSH Document Engine environment
#
# Copy to `.env` for local development and fill in only what you need.
# Every value below is a safe placeholder: this file must never contain real
# credentials, tokens or customer document paths.
#
# The same variables are read by the MCP server (`node apps/mcp/dist/main.js`),
# the web server and the CLI. See SECURITY.md for the confinement rules these
# settings enforce.

# ---------------------------------------------------------------------------
# Workspace confinement (required for anything that touches files)
# ---------------------------------------------------------------------------

# Root directory that document_create / document_open / document_import may
# read from and document_save / document_save_as / document_export may write
# to. Absolute path recommended. Paths outside this root are rejected with
# WORKSPACE_PATH_DENIED; there is no implicit parent-directory escape.
DSH_DOC_WORKSPACE=./workspace

# When "1", "true" or "yes", every mutating tool and save/export path is
# refused (READ_ONLY_MODE). Read-only tools continue to work. Use this for
# untrusted documents, shared agents, and CI.
DSH_DOC_READ_ONLY=1

# Append-only JSONL audit log of tool calls (document id, operation, outcome,
# byte counts, actor). Empty means audit logging is disabled. Keep the file
# inside the workspace or another operator-controlled directory.
DSH_DOC_AUDIT_LOG=./workspace/.audit/audit.jsonl

# Largest accepted upload/import, in megabytes. Requests above the limit fail
# with FILE_TOO_LARGE rather than being truncated.
DSH_DOC_MAX_UPLOAD_MB=50

# ---------------------------------------------------------------------------
# AI assistance (optional; without a provider the AI tools report
# AI_NOT_CONFIGURED and the deterministic editing tools are unaffected)
# ---------------------------------------------------------------------------

# "offline" (default; no network, deterministic local summaries and checks),
# "openai" (compatible HTTP endpoint) or "ollama" (local runtime).
DSH_DOC_AI_PROVIDER=offline

# Model identifier understood by the selected provider, e.g. a hosted model
# name for "openai" or a locally pulled tag for "ollama".
DSH_DOC_AI_MODEL=offline-deterministic

# Provider credentials. Leave empty for "offline" and "ollama".
# Never commit a real key; load it from your secret store or shell environment.
OPENAI_API_KEY=
# Base URL for an OpenAI-compatible gateway. Empty means the provider default.
# Example: http://127.0.0.1:8080/v1
OPENAI_BASE_URL=

# Ollama endpoint used when DSH_DOC_AI_PROVIDER=ollama.
OLLAMA_HOST=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# Web / editor server
# ---------------------------------------------------------------------------

# HTTP port for the editor UI and its API. The MCP server speaks stdio and
# does not use this value.
PORT=3000

# Comma-separated browser origins allowed to call the editor API. "*" disables
# the origin allow-list and is intended only for isolated local development.
DSH_DOC_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
