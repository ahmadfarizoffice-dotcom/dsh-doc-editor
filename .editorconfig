# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Binary document fixtures are opaque; never normalize their bytes.
[*.{docx,docm,dotx,pdf,png,jpg,jpeg,gif,webp,ico}]
insert_final_newline = false
charset = unset
end_of_line = unset
